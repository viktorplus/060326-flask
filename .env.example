# Шаблон файла окружения. Скопируйте его в .env рядом:
#     cp .env.example .env          (Git Bash)
#     Copy-Item .env.example .env   (PowerShell)
#
# Сам .env занесён в .gitignore и в репозиторий не попадает — это стандартная
# практика: в нём держат значения, специфичные для машины, и секреты.
# Здесь секретов нет, значения учебные, поэтому шаблон содержит их как есть.
#
# Читает эти переменные только l03_rest_api/app.py.

# ВНИМАНИЕ, ключ называется DB_USERNAME, а не USERNAME — и это принципиально.
# На Windows переменная USERNAME уже занята системой (там имя пользователя ОС),
# а load_dotenv() по умолчанию НЕ перезаписывает существующие переменные
# окружения (override=False). Значение из .env было бы молча проигнорировано,
# и в приложение попало бы имя пользователя Windows — без единой ошибки.
# Отсюда правило: давать ключам в .env префикс проекта или подсистемы.
DB_USERNAME=admin

# Заготовка на будущий урок с настоящей БД: в l03_rest_api данные пока лежат
# в JSON-файле, и строка подключения conn_str нигде не используется.
DRIVER=sqlite
